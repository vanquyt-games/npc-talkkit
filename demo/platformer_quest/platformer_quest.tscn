[sub_resource type="Resource" id="Resource_0exkh"]
script = ExtResource("9_fwqju")
text = "Ha. Fair question. There's an old blaster in my workshop."
event_payload = null
line_id = &"ada_reward_1"

[sub_resource type="Resource" id="Resource_jpc3j"]
script = ExtResource("9_fwqju")
text = "It's yours once the power cell is paid for. Deal?"
event_id = &"ada_offer"
event_payload = {
"branches": ["ada_accept", "ada_reward", "ada_decline"],
"options": ["Sure, I'll find them.", "What's in it for me?", "Not right now."]
}
event_blocking = true
line_id = &"ada_reward_2"

[sub_resource type="Resource" id="Resource_vr75o"]
