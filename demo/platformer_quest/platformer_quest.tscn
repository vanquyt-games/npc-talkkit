[sub_resource type="Resource" id="Resource_am22w"]
script = ExtResource("9_fwqju")
text = "Oh! A robot that still walks. Mine all rusted shut years ago."
event_payload = null
line_id = &"ada_intro_1"

[sub_resource type="Resource" id="Resource_utokv"]
script = ExtResource("9_fwqju")
text = "I'm Ada. I fix things around here, when I have the parts."
event_payload = null
line_id = &"ada_intro_2"

[sub_resource type="Resource" id="Resource_y0ltv"]
script = ExtResource("9_fwqju")
text = "The crabs knocked my coins all over the cliffs, and I need {{coins_needed}} of them for a new power cell."
event_payload = null
line_id = &"ada_intro_3"

[sub_resource type="Resource" id="Resource_d3u11"]
script = ExtResource("9_fwqju")
text = "Could you bring them back, {{player_name}}?"
event_id = &"ada_offer"
event_payload = {
"branches": ["ada_accept", "ada_reward", "ada_decline"],
"options": ["Sure, I'll find them.", "What's in it for me?", "Not right now."]
}
event_blocking = true
line_id = &"ada_intro_4"

[sub_resource type="Resource" id="Resource_yqr0q"]
script = ExtResource("6_42wsl")
conversation_id = &"ada_intro"
