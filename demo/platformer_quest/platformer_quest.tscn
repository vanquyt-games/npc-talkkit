event_payload = null

[sub_resource type="Resource" id="Resource_1uadx"]
script = ExtResource("9_fwqju")
text = "Wonderful. Jump, then jump again in the air: your legs can reach the high ledges."
event_payload = null
line_id = &"ada_accept_1"

[sub_resource type="Resource" id="Resource_sdbk6"]
script = ExtResource("9_fwqju")
text = "Come back when you have {{coins_needed}}."
event_id = &"quest_started"
event_payload = null
line_id = &"ada_accept_2"

[sub_resource type="Resource" id="Resource_cppx5"]
script = ExtResource("6_42wsl")
